# ============================================================
# FarmChain Backend — Application Configuration
# ============================================================
# Copy this file to application.properties and fill in values.
# NEVER commit application.properties — it's in .gitignore.
# Only commit this .example file.
# ============================================================

spring.application.name=farmchain-backend

# === DATABASE (Neon PostgreSQL) ===
# Get this from your Neon project dashboard → Connection string
spring.datasource.url=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DB_NAME?sslmode=require
spring.datasource.username=YOUR_NEON_USERNAME
spring.datasource.password=YOUR_NEON_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# Connection pool (HikariCP)
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=300000

# === JPA ===
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# === FLYWAY (DB Migrations) ===
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true

# === JWT AUTH ===
# Generate a strong secret: openssl rand -hex 64
farmchain.jwt.secret=YOUR_JWT_SECRET_MIN_64_CHARS
farmchain.jwt.access-token-expiry-ms=900000
farmchain.jwt.refresh-token-expiry-days=7

# === CORS ===
farmchain.cors.allowed-origins=http://localhost:5173,https://your-production-frontend.vercel.app

# === SERVER ===
server.port=8080

# === ACTUATOR (Health checks for Render) ===
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=when-authorized

# === LOGGING ===
logging.level.com.farmchain=INFO
logging.level.org.springframework.security=WARN
